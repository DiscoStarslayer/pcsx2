  </ItemGroup>
  <Target Name="CopyRuntimeDependency" AfterTargets="Build" Inputs="@(RuntimeDependency)" Outputs="@(RuntimeDependency -&gt; '$(OutDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(RuntimeDependency)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
